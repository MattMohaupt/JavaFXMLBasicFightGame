<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.controller.WinController"
      alignment="CENTER" spacing="20"
      style="-fx-background-color: #1e5631;">

    <Label fx:id="titleLabel" text="YOU WIN!"
           style="-fx-font-size: 48px; -fx-text-fill: white; -fx-font-weight: bold;"/>

    <Label fx:id="subtitleLabel" text=""
           style="-fx-font-size: 18px; -fx-text-fill: #d0e8d0;"/>

    <Button fx:id="nextLevelButton" text="Next Level"
            style="-fx-font-size: 20px; -fx-padding: 10 30 10 30;"/>

    <Button fx:id="replayButton" text="Replay Level"
            style="-fx-font-size: 16px; -fx-padding: 8 24 8 24;"/>
</VBox>