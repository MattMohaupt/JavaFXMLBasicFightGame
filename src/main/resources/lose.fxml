<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.controller.LoseController"
      alignment="CENTER" spacing="20"
      style="-fx-background-color: #5a1e1e;">

    <Label fx:id="titleLabel" text="YOU LOST!"
           style="-fx-font-size: 48px; -fx-text-fill: white; -fx-font-weight: bold;"/>

    <Label text="An enemy got you."
           style="-fx-font-size: 18px; -fx-text-fill: #e8d0d0;"/>

    <Button fx:id="retryButton" text="Try Again"
            style="-fx-font-size: 20px; -fx-padding: 10 30 10 30;"/>

    <Button fx:id="menuButton" text="Main Menu"
            style="-fx-font-size: 16px; -fx-padding: 8 24 8 24;"/>
</VBox>